{
  "expo": {
    "name": "Annamalaiyar Gramathu Paalagam",
    "slug": "milk-subscription-simple",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/agp.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#2E7D32"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.milksubscriptionsimple",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2E7D32"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.milksubscriptionsimple"
    },
    "web": {
      "favicon": "./assets/agp.png",
      "name": "Annamalaiyar Gramathu Paalagam"
    },
    "extra": {
      "eas": {
        "projectId": "60983ebd-a1ac-4722-b8c5-a74469e8f727"
      }
    },
    "owner": "annamalaiyargramathupalagam",
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-font"
    ]
  }
}
